  Image             
  GuestOS           
  Containerfile     $CTX/Dockerfile
  OutputDir         warden-output
  CaptureMode       
  Compress          true
  Quiet             false
  Timeout           0s
  CPUs              0
  MemoryMB          0
  Network           
  KeepVMs           false
  ImageRefreshAfter 0s
  ImageMinGrace     0s
