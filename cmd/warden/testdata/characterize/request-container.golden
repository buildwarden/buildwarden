== config file: warden build --driver container $CTX
warden.toml:
    [build]
    capture = "bodies"
    output_dir = "o"
    compress = false
    tmpdir = "t"
    [relay]
    system_ca_bundle = false
    [runtime]
    relay_image = "dev"
    [vm]
    cpus = 2
    memory_mb = 2048
    network = "warden-ci"
    image_refresh_after = "3d"
    image_min_grace = "6h"
    build_link = "10.9.0.4/30"
    dns = ["10.20.0.53"]
