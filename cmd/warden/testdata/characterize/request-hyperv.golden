== config file: warden build --driver hyperv $CTX
warden.toml:
    [build]
    capture = "bodies"
    output_dir = "o"
    compress = false
    tmpdir = "t"
    [relay]
    system_ca_bundle = false
    [runtime]
    relay_image = "dev"
    [vm]
    cpus = 2
    memory_mb = 2048
    network = "warden-ci"
    image_refresh_after = "3d"
    image_min_grace = "6h"
    build_link = "10.9.0.4/30"
    dns = ["10.20.0.53"]
  Script            
  ContextDir        $CTX
  Image             
  GuestOS           
  Containerfile     $CTX/Dockerfile
  OutputDir         o
  CaptureMode       bodies
  Compress          false
  Quiet             false
  Timeout           0s
  CPUs              2
  MemoryMB          2048
  Network           warden-ci
  KeepVMs           false
  ImageRefreshAfter 72h0m0s
  ImageMinGrace     6h0m0s
  TempDir           $CTX/t
  RelayImage        
  UpstreamCACerts   0 bytes
  UpstreamSystemCA  false
  BuildLink         10.9.0.4/30
  DNS               [10.20.0.53]
  Env               map[]
