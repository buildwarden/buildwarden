== [VM] image_refresh_after: warden build --driver hyperv $CTX
warden.toml:
    [VM]
    image_refresh_after = "3d"
  error: $CTX/warden.toml: [VM] image_refresh_after: keys are case-sensitive, and the hyperv driver reads [driver] image_refresh_after (old name [vm] image_refresh_after)
  fix:   write it as [driver] image_refresh_after
== [vm] Image_Min_Grace: warden build --driver hyperv $CTX
warden.toml:
    [vm]
    Image_Min_Grace = "6h"
  error: $CTX/warden.toml: [vm] Image_Min_Grace: keys are case-sensitive, and the hyperv driver reads [driver] image_min_grace (old name [vm] image_min_grace)
  fix:   write it as [driver] image_min_grace
== [vm] Network: warden build --driver hyperv $CTX
warden.toml:
    [vm]
    Network = "warden-ci"
  error: $CTX/warden.toml: [vm] Network: keys are case-sensitive, and the hyperv driver reads [driver.hyperv] network (old name [vm] network)
  fix:   write it as [driver.hyperv] network
== [Vm] windows_image: warden build --driver hyperv $CTX
warden.toml:
    [Vm]
    windows_image = "w.vhdx"
  error: $CTX/warden.toml: [Vm] windows_image: keys are case-sensitive, and the hyperv driver reads [driver.hyperv] windows_image (old name [vm] windows_image)
  fix:   write it as [driver.hyperv] windows_image
== [vm] WINDOWS_IMAGE_UPDATE: warden build --driver hyperv $CTX
warden.toml:
    [vm]
    WINDOWS_IMAGE_UPDATE = "reuse"
  error: $CTX/warden.toml: [vm] WINDOWS_IMAGE_UPDATE: keys are case-sensitive, and the hyperv driver reads [driver.hyperv] windows_image_update (old name [vm] windows_image_update)
  fix:   write it as [driver.hyperv] windows_image_update
