# Files that execute on Linux must keep LF endings regardless of the host's
# core.autocrlf. In particular tools/relay-vm/**/init becomes the relay VM's
# PID 1 and is embedded verbatim in the initramfs — a CRLF shebang/line would
# break the VM boot.
*.sh                       text eol=lf
tools/relay-vm/init        text eol=lf
tools/relay-vm/hyperv/init text eol=lf
# Golden files are compared byte for byte; a CRLF checkout on Windows would
# fail them (GLOBAL-07).
tools/tier1/**/testdata/**    text eol=lf
tools/workflow/**/testdata/** text eol=lf
