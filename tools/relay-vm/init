#!/bin/sh
# Relay VM init, shared by every VM driver (qemu: aarch64/x86_64 virtio;
# hyperv: x86_64 VMBus). The trust boundary: this script and everything it
# invokes is outside the build VM's influence.
#
# The relay VM has no data disk. It mounts nothing but, on Hyper-V, the relay
# seed's CD, read-only, long enough to copy one file. The relay binary lives in
# the initramfs at /sbin/relay (baked by the Hyper-V boot-disk build, appended
# as an extra cpio by the qemu driver). It boots UNCONFIGURED and waits for the
# orchestrator's claim on :8301 (see relaycfg); every output streams to the
# host collector named in that claim.
#
# Network topology (same for every driver):
#   eth0 = private link to the build VM (the build link). This init only
#          brings it up; the relay addresses it from the claim's build_link
#          and serves the build VM's DHCP lease on it (cmd/relay vmlink.go)
#   eth1 = upstream link to the host/internet
#   iptables: PREROUTING REDIRECT 80/443/53 on eth0; POSTROUTING MASQUERADE
#             eth1; FORWARD DROP (no un-proxied egress from the build VM).
#
# Boot keys: the relay's pre-claim values only (RELAY-08). Everything else,
# the build link, the collector and the upstream resolvers (upstream_dns),
# comes in the claim. Each key is a warden.<key>=<value> word, read by
# read_keys from /proc/cmdline and, on Hyper-V, from the relay seed. Only these
# keys are read, the words are never evaluated, and a malformed value stops
# the init with a console line (no relay starts, so the claim times out with
# this log as the evidence):
#   warden.net=dhcp|static   upstream addressing (default dhcp)
#   warden.nat_ip=           static upstream address, a dotted quad
#   warden.nat_prefix=       its prefix length, 1 to 30
#   warden.nat_gw=           its gateway, a dotted quad
#                            (static needs all three; there are no defaults)
#   warden.claim_token=      per-instance claim token, 64 lowercase hex digits
#                            (WARDEN_CLAIM_TOKEN; never printed)
#   warden.seed=1            the relay seed's format version
# warden.dns is retired: an init that finds it stops, naming upstream_dns in
# the claim, rather than ignore a value someone set.
#
# The relay seed (Hyper-V only, where nothing per build reaches the kernel
# command line): an ISO 9660 CD, volume label WARDENRELAY, attached to the
# relay VM per build, holding warden-relay.conf, one warden.<key>=<value> per
# line, among them warden.seed=1. The init waits up to 10 s for the CD,
# mounts it read-only, copies the file to /tmp and unmounts it. No seed, or a
# warden.seed other than 1, stops the init.

# Words from the command line and the seed are split, never glob-expanded.
set -f

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp

HYPERV=0
[ -d /sys/bus/vmbus ] && HYPERV=1

# On Hyper-V the host watches COM1 (a named pipe); mirror progress there.
say() {
    echo "init: $*"
    if [ "$HYPERV" = 1 ]; then echo "init: $*" > /dev/ttyS0 2>/dev/null || true; fi
}

# Load modules (deps first). Missing modules are skipped: each platform's
# initramfs carries only the ones it needs (hv_netvsc is built into the
# linux-virt kernel). crc32c_generic MUST precede libcrc32c, or libcrc32c fails
# to init and strands nf_conntrack and the netfilter chain behind it.
for mod in \
    rng-core virtio-rng \
    af_packet \
    failover net_failover virtio_net \
    crc32c_generic libcrc32c \
    nf_defrag_ipv4 nf_defrag_ipv6 x_tables nf_conntrack nf_nat \
    ip_tables iptable_filter iptable_nat xt_tcpudp \
    xt_REDIRECT xt_MASQUERADE xt_conntrack xt_state \
    nfnetlink nf_tables; do
    [ -f "/lib/modules/${mod}.ko" ] && insmod "/lib/modules/${mod}.ko" 2>/dev/null
done

# stop ends the boot with a console line: no relay starts, so the
# orchestrator's claim times out with this log as the evidence. PID 1 must
# never exit (the kernel would panic), so it idles for host teardown.
stop() {
    say "stopped: $*"
    while true; do sleep 3600; done
}

is_quad() {
    case "$1" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
    old_ifs=$IFS; IFS=.
    # shellcheck disable=SC2086 # split on the dots
    set -- $1
    IFS=$old_ifs
    [ $# -eq 4 ] || return 1
    for octet in "$@"; do
        case "$octet" in 0?*|????*) return 1 ;; esac
        [ "$octet" -le 255 ] || return 1
    done
}

# read_keys SOURCE: reads warden.<key>=<value> words from stdin (SOURCE names
# it in console lines). Only the known keys are taken and each value is
# checked; other words are skipped.
read_keys() {
    keys=""
    for kv in $(cat); do
        v="${kv#*=}"
        case "$kv" in
            warden.net=*)
                case "$v" in dhcp|static) ;; *)
                    stop "warden.net=$v from $1: want dhcp or static" ;; esac
                NET_MODE="$v" ;;
            warden.nat_ip=*)
                is_quad "$v" || stop "warden.nat_ip=$v from $1 is not a dotted quad"
                NAT_IP="$v" ;;
            warden.nat_prefix=*)
                case "$v" in [1-9]|[12][0-9]|30) ;; *)
                    stop "warden.nat_prefix=$v from $1: want 1 to 30" ;; esac
                NAT_PREFIX="$v" ;;
            warden.nat_gw=*)
                is_quad "$v" || stop "warden.nat_gw=$v from $1 is not a dotted quad"
                NAT_GW="$v" ;;
            warden.claim_token=*)
                case "$v" in *[!0-9a-f]*) v="" ;; esac
                [ "${#v}" -eq 64 ] ||
                    stop "warden.claim_token from $1 is not 64 lowercase hex digits"
                CLAIM_TOKEN="$v" ;;
            warden.seed=*)
                [ "$v" = 1 ] ||
                    stop "no relay seed (WARDENRELAY): warden.seed=$v from $1, want 1"
                SEED_VERSION="$v" ;;
            warden.dns=*)
                stop "warden.dns from $1 is retired: send the relay's resolvers" \
                    "as upstream_dns in the claim" ;;
            *) continue ;;
        esac
        keys="$keys ${kv%%=*}"
    done
    say "keys from $1:${keys:- none}"
}

# read_seed copies the relay seed's warden-relay.conf from its CD to /tmp,
# or stops when there is none.
read_seed() {
    TRIES=0
    while [ ! -b /dev/sr0 ] && [ $TRIES -lt 100 ]; do
        TRIES=$((TRIES + 1)); sleep 0.1
    done
    [ -b /dev/sr0 ] || stop "no relay seed (WARDENRELAY): no CD after 10 s"
    mkdir -p /run/seed
    mount -t iso9660 -o ro /dev/sr0 /run/seed ||
        stop "no relay seed (WARDENRELAY): the CD does not mount"
    cp /run/seed/warden-relay.conf /tmp/warden-relay.conf 2>/dev/null
    umount /run/seed
    [ -f /tmp/warden-relay.conf ] ||
        stop "no relay seed (WARDENRELAY): the CD holds no warden-relay.conf"
}

NET_MODE=dhcp
NAT_IP=""
NAT_PREFIX=""
NAT_GW=""
CLAIM_TOKEN=""
SEED_VERSION=""
read_keys /proc/cmdline < /proc/cmdline
if [ "$HYPERV" = 1 ]; then
    for mod in scsi_common scsi_mod scsi_transport_fc hv_storvsc cdrom sr_mod isofs; do
        [ -f "/lib/modules/${mod}.ko" ] && insmod "/lib/modules/${mod}.ko" 2>/dev/null
    done
    read_seed
    SEED_VERSION=""
    read_keys "the relay seed" < /tmp/warden-relay.conf
    [ "$SEED_VERSION" = 1 ] || stop "no relay seed (WARDENRELAY): no warden.seed=1"
fi
if [ "$NET_MODE" = static ] &&
    { [ -z "$NAT_IP" ] || [ -z "$NAT_PREFIX" ] || [ -z "$NAT_GW" ]; }; then
    stop "warden.net=static needs warden.nat_ip, warden.nat_prefix and warden.nat_gw"
fi

# Wait for NICs.
TRIES=0
while [ $TRIES -lt 50 ]; do
    IFACES=$(ls /sys/class/net/ 2>/dev/null | grep -v lo)
    [ -n "$IFACES" ] && break
    TRIES=$((TRIES + 1)); sleep 0.1
done

# eth0 = build link. Up only: the relay addresses it from the claim, before it
# answers, and serves the build VM's DHCP lease on it. No rule here names an
# address, so nothing below waits for that.
PRIVATE_IF=$(echo "$IFACES" | head -1)
if [ -n "$PRIVATE_IF" ]; then
    ip link set "$PRIVATE_IF" up
    say "build-if=$PRIVATE_IF up; the relay addresses it from the claim"
fi

# eth1 = upstream link.
static_upstream() {
    ip addr add "$NAT_IP/$NAT_PREFIX" dev "$NAT_IF"
    ip route add default via "$NAT_GW"
}
NAT_IF=$(echo "$IFACES" | sed -n '2p')
if [ -n "$NAT_IF" ]; then
    ip link set "$NAT_IF" up
    if [ "$NET_MODE" = dhcp ]; then
        mkdir -p /usr/share/udhcpc
        cat > /usr/share/udhcpc/default.script << 'DHCP'
#!/bin/sh
case "$1" in
    bound|renew)
        ip addr flush dev "$interface"
        ip addr add "$ip/${mask:-24}" dev "$interface"
        [ -n "$router" ] && ip route add default via "$router"
        if [ -n "$dns" ]; then
            : > /etc/resolv.conf
            for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
        fi
        ;;
esac
DHCP
        chmod 755 /usr/share/udhcpc/default.script
        udhcpc -i "$NAT_IF" -q -t 10 -T 2 -A 3 -n >/dev/null 2>&1 ||
            stop "no DHCP lease on $NAT_IF (warden.net=dhcp)"
    else
        static_upstream
    fi
    say "nat-if=$NAT_IF $(ip addr show "$NAT_IF" 2>/dev/null | grep 'inet ' | tr '\n' ' ')"
fi

# All iptables rules are IPv4; disable IPv6 to prevent bypass.
echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6
echo 1 > /proc/sys/net/ipv4/ip_forward

# Default DROP for forwarded build-VM traffic; REDIRECT rewrites proxied
# packets to the local relay (they hit INPUT, not FORWARD).
iptables -P FORWARD DROP
iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

if [ -n "$PRIVATE_IF" ]; then
    for p in "tcp 80" "tcp 443" "udp 53" "tcp 53"; do
        set -- $p
        iptables -t nat -A PREROUTING -i "$PRIVATE_IF" -p "$1" --dport "$2" \
            -j REDIRECT --to-port "$2"
    done
    # The build VM may reach the control plane, never the claim port.
    iptables -A INPUT -i "$PRIVATE_IF" -p tcp --dport 8300 -j ACCEPT
    iptables -A INPUT -i "$PRIVATE_IF" -p tcp --dport 8301 -j DROP
    iptables -A INPUT -i "$PRIVATE_IF" -p icmp -j DROP
fi
if [ -n "$NAT_IF" ]; then
    iptables -t nat -A POSTROUTING -o "$NAT_IF" -j MASQUERADE
fi

# Launch the relay. PID 1 must never exit (the kernel would panic), so init
# supervises: when the relay returns, or is absent in a bare boot test, it idles
# for host teardown.
if [ -x /sbin/relay ]; then
    say "ready; relay awaiting claim on :8301"
    if [ "$HYPERV" = 1 ]; then
        WARDEN_CLAIM_TOKEN="$CLAIM_TOKEN" /sbin/relay -mode vm \
            -build-if "$PRIVATE_IF" > /dev/ttyS0 2>&1
    else
        WARDEN_CLAIM_TOKEN="$CLAIM_TOKEN" /sbin/relay -mode vm -build-if "$PRIVATE_IF"
    fi
    say "relay exited ($?); idling for host teardown"
else
    say "no relay binary present; idling (boot-test mode)"
fi
while true; do sleep 3600; done
