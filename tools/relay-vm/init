#!/bin/sh
# Relay VM init, shared by every VM driver (qemu: aarch64/x86_64 virtio;
# hyperv: x86_64 VMBus). The trust boundary: this script and everything it
# invokes is outside the build VM's influence.
#
# The relay VM has no data disk and mounts nothing. The relay binary lives in
# the initramfs at /sbin/relay (baked by the Hyper-V boot-disk build, appended
# as an extra cpio by the qemu driver). It boots UNCONFIGURED and waits for the
# orchestrator's claim on :8301 (see relaycfg); every output streams to the
# host collector named in that claim.
#
# Network topology (same for every driver):
#   eth0 = private link to the build VM (10.0.0.1/30)
#   eth1 = upstream link to the host/internet
#   iptables: PREROUTING REDIRECT 80/443/53 on eth0; POSTROUTING MASQUERADE
#             eth1; FORWARD DROP (no un-proxied egress from the build VM).
#
# Kernel command line (all optional):
#   warden.net=dhcp|static   upstream addressing; default dhcp, except static
#                            on Hyper-V (New-NetNat has no DHCP server)
#   warden.nat_ip= warden.nat_prefix= warden.nat_gw=
#                            static upstream address (default 192.168.240.2/20
#                            via 192.168.240.1)
#   warden.dns=              upstream resolver(s), comma-separated
#   warden.claim_token=      per-instance claim token (WARDEN_CLAIM_TOKEN)

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp

HYPERV=0
[ -d /sys/bus/vmbus ] && HYPERV=1

# On Hyper-V the host watches COM1 (a named pipe); mirror progress there.
say() {
    echo "init: $*"
    if [ "$HYPERV" = 1 ]; then echo "init: $*" > /dev/ttyS0 2>/dev/null || true; fi
}

# Load modules (deps first). Missing modules are skipped: each platform's
# initramfs carries only the ones it needs (hv_netvsc is built into the
# linux-virt kernel). crc32c_generic MUST precede libcrc32c, or libcrc32c fails
# to init and strands nf_conntrack and the netfilter chain behind it.
for mod in \
    rng-core virtio-rng \
    af_packet \
    failover net_failover virtio_net \
    crc32c_generic libcrc32c \
    nf_defrag_ipv4 nf_defrag_ipv6 x_tables nf_conntrack nf_nat \
    ip_tables iptable_filter iptable_nat xt_tcpudp \
    xt_REDIRECT xt_MASQUERADE xt_conntrack xt_state \
    nfnetlink nf_tables; do
    [ -f "/lib/modules/${mod}.ko" ] && insmod "/lib/modules/${mod}.ko" 2>/dev/null
done

# Parse only known warden.* keys; the command line is never evaluated.
NET_MODE=dhcp
[ "$HYPERV" = 1 ] && NET_MODE=static
NAT_IP=192.168.240.2
NAT_PREFIX=20
NAT_GW=192.168.240.1
UPSTREAM_DNS=""
CLAIM_TOKEN=""
for kv in $(cat /proc/cmdline); do
    case "$kv" in
        warden.net=*)         NET_MODE="${kv#*=}" ;;
        warden.nat_ip=*)      NAT_IP="${kv#*=}" ;;
        warden.nat_prefix=*)  NAT_PREFIX="${kv#*=}" ;;
        warden.nat_gw=*)      NAT_GW="${kv#*=}" ;;
        warden.dns=*)         UPSTREAM_DNS="$(echo "${kv#*=}" | tr ',' ' ')" ;;
        warden.claim_token=*) CLAIM_TOKEN="${kv#*=}" ;;
    esac
done

# Wait for NICs.
TRIES=0
while [ $TRIES -lt 50 ]; do
    IFACES=$(ls /sys/class/net/ 2>/dev/null | grep -v lo)
    [ -n "$IFACES" ] && break
    TRIES=$((TRIES + 1)); sleep 0.1
done

# eth0 = build link: static gateway for the build VM.
PRIVATE_IF=$(echo "$IFACES" | head -1)
if [ -n "$PRIVATE_IF" ]; then
    ip link set "$PRIVATE_IF" up
    ip addr add 10.0.0.1/30 dev "$PRIVATE_IF"
    say "build-if=$PRIVATE_IF 10.0.0.1/30"
fi

# eth1 = upstream link.
static_upstream() {
    ip addr add "$NAT_IP/$NAT_PREFIX" dev "$NAT_IF"
    ip route add default via "$NAT_GW"
}
NAT_IF=$(echo "$IFACES" | sed -n '2p')
if [ -n "$NAT_IF" ]; then
    ip link set "$NAT_IF" up
    if [ "$NET_MODE" = dhcp ]; then
        mkdir -p /usr/share/udhcpc
        cat > /usr/share/udhcpc/default.script << 'DHCP'
#!/bin/sh
case "$1" in
    bound|renew)
        ip addr flush dev "$interface"
        ip addr add "$ip/${mask:-24}" dev "$interface"
        [ -n "$router" ] && ip route add default via "$router"
        if [ -n "$dns" ]; then
            : > /etc/resolv.conf
            for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
        fi
        ;;
esac
DHCP
        chmod 755 /usr/share/udhcpc/default.script
        udhcpc -i "$NAT_IF" -q -t 10 -T 2 -A 3 -n >/dev/null 2>&1 || {
            say "dhcp failed on $NAT_IF; using static $NAT_IP/$NAT_PREFIX"
            static_upstream
        }
    else
        static_upstream
    fi
    say "nat-if=$NAT_IF $(ip addr show "$NAT_IF" 2>/dev/null | grep 'inet ' | tr '\n' ' ')"
fi

# All iptables rules are IPv4; disable IPv6 to prevent bypass.
echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6
echo 1 > /proc/sys/net/ipv4/ip_forward

# Default DROP for forwarded build-VM traffic; REDIRECT rewrites proxied
# packets to the local relay (they hit INPUT, not FORWARD).
iptables -P FORWARD DROP
iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

if [ -n "$PRIVATE_IF" ]; then
    for p in "tcp 80" "tcp 443" "udp 53" "tcp 53"; do
        set -- $p
        iptables -t nat -A PREROUTING -i "$PRIVATE_IF" -p "$1" --dport "$2" \
            -j REDIRECT --to-port "$2"
    done
    # The build VM may reach the control plane, never the claim port.
    iptables -A INPUT -i "$PRIVATE_IF" -p tcp --dport 8300 -j ACCEPT
    iptables -A INPUT -i "$PRIVATE_IF" -p tcp --dport 8301 -j DROP
    iptables -A INPUT -i "$PRIVATE_IF" -p icmp -j DROP
fi
if [ -n "$NAT_IF" ]; then
    iptables -t nat -A POSTROUTING -o "$NAT_IF" -j MASQUERADE
fi

# DNS for the relay's own upstream resolution (build-VM DNS is redirected here).
if [ -n "$UPSTREAM_DNS" ] || [ ! -s /etc/resolv.conf ]; then
    : > /etc/resolv.conf
    for d in ${UPSTREAM_DNS:-8.8.8.8}; do echo "nameserver $d" >> /etc/resolv.conf; done
fi
say "dns=$(grep nameserver /etc/resolv.conf 2>/dev/null | head -1)"

# Launch the relay. PID 1 must never exit (the kernel would panic), so init
# supervises: when the relay returns, or is absent in a bare boot test, it idles
# for host teardown.
if [ -x /sbin/relay ]; then
    say "ready; relay awaiting claim on :8301"
    if [ "$HYPERV" = 1 ]; then
        WARDEN_CLAIM_TOKEN="$CLAIM_TOKEN" /sbin/relay -mode vm > /dev/ttyS0 2>&1
    else
        WARDEN_CLAIM_TOKEN="$CLAIM_TOKEN" /sbin/relay -mode vm
    fi
    say "relay exited ($?); idling for host teardown"
else
    say "no relay binary present; idling (boot-test mode)"
fi
while true; do sleep 3600; done
