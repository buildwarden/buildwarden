#!/bin/sh
# Relay VM init - Hyper-V variant (x86_64). The trust boundary; this script and
# everything it invokes is outside the build VM's influence.
#
# Differences from the qemu/virtio init (tools/relay-vm/init):
#   - hv_vmbus and hv_netvsc are built into Alpine's linux-virt kernel, so VMBus
#     and the synthetic NICs come up with no insmod.
#   - There is NO data disk. The relay binary is baked into this initramfs and
#     outputs stream to the host collector over HTTP, so nothing is mounted
#     (no hv_storvsc, no vfat, no /dev/sda). Per-build config (collector URL +
#     token) is fetched over the network once the NAT link is up.
#   - The NAT NIC uses a STATIC IP: Hyper-V's New-NetNat provides routing but no
#     DHCP server.
#   - Readiness is signalled to the host over COM1 (/dev/ttyS0), a named pipe.
#
# Network topology (unchanged from the other drivers):
#   eth0 = private link to build VM (10.0.0.1/30)
#   eth1 = NAT switch to host/internet (static 192.168.240.2/20 by default)
#   iptables: PREROUTING REDIRECT 80/443/53 on eth0; POSTROUTING MASQUERADE eth1;
#             FORWARD DROP (no un-proxied egress from the build VM).

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp

# Load modules (deps first). Missing modules are skipped, not fatal.
# No data-disk modules (hv_storvsc/fat/vfat): outputs stream to the host
# collector over HTTP, so the relay VM has no block device to mount.
# crc32c_generic MUST precede libcrc32c: libcrc32c's module-init allocates a
# "crc32c" shash and fails to load if the algorithm provider isn't registered
# yet, which then strands nf_conntrack ("Unknown symbol crc32c") and the whole
# netfilter chain that depends on it.
for mod in \
    af_packet \
    crc32c_generic libcrc32c \
    nf_defrag_ipv4 nf_defrag_ipv6 x_tables nf_conntrack nf_nat \
    ip_tables iptable_filter iptable_nat xt_tcpudp \
    xt_REDIRECT xt_MASQUERADE xt_conntrack xt_state \
    nfnetlink nf_tables; do
    [ -f "/lib/modules/${mod}.ko" ] && insmod "/lib/modules/${mod}.ko" 2>/dev/null
done

# No data disk. The relay binary is baked into this initramfs and outputs stream
# to the host collector over HTTP, so there is nothing to mount here. The NAT
# interface config below keeps its baked static defaults; per-build relay config
# (collector URL + token) is fetched over the network after the NAT link is up
# (config-fetch seam near the end of this script).

# Wait for the synthetic NICs (hv_netvsc, built-in).
TRIES=0
while [ $TRIES -lt 50 ]; do
    IFACES=$(ls /sys/class/net/ 2>/dev/null | grep -v lo)
    [ -n "$IFACES" ] && break
    TRIES=$((TRIES + 1)); sleep 0.1
done

# eth0 = build link (Private switch): static gateway for the build VM.
PRIVATE_IF=$(echo "$IFACES" | head -1)
if [ -n "$PRIVATE_IF" ]; then
    ip link set "$PRIVATE_IF" up
    ip addr add 10.0.0.1/30 dev "$PRIVATE_IF"
fi

# eth1 = NAT switch (relay upstream): STATIC (New-NetNat has no DHCP).
NAT_IF=$(echo "$IFACES" | sed -n '2p')
if [ -n "$NAT_IF" ]; then
    ip link set "$NAT_IF" up
    ip addr add "${NAT_IP:-192.168.240.2}/${NAT_PREFIX:-20}" dev "$NAT_IF"
    ip route add default via "${NAT_GW:-192.168.240.1}"
    echo "init: nat-if=$NAT_IF $(ip addr show "$NAT_IF" 2>/dev/null | grep inet)"
fi

# All iptables rules are IPv4; disable IPv6 to prevent bypass.
echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6
echo 1 > /proc/sys/net/ipv4/ip_forward

# Default DROP for forwarded build-VM traffic; REDIRECT rewrites proxied
# packets to the local relay (they hit INPUT, not FORWARD).
iptables -P FORWARD DROP
iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

if [ -n "$PRIVATE_IF" ]; then
    iptables -t nat -A PREROUTING -i "$PRIVATE_IF" -p tcp --dport 80 \
        -j REDIRECT --to-port 80
    iptables -t nat -A PREROUTING -i "$PRIVATE_IF" -p tcp --dport 443 \
        -j REDIRECT --to-port 443
    iptables -t nat -A PREROUTING -i "$PRIVATE_IF" -p udp --dport 53 \
        -j REDIRECT --to-port 53
    iptables -t nat -A PREROUTING -i "$PRIVATE_IF" -p tcp --dport 53 \
        -j REDIRECT --to-port 53
    iptables -A INPUT -i "$PRIVATE_IF" -p tcp --dport 8300 -j ACCEPT
    iptables -A INPUT -i "$PRIVATE_IF" -p icmp -j DROP
fi
if [ -n "$NAT_IF" ]; then
    iptables -t nat -A POSTROUTING -o "$NAT_IF" -j MASQUERADE
fi

# DNS for the relay's own upstream resolution (build-VM DNS is redirected here).
if [ ! -s /etc/resolv.conf ]; then
    if [ -n "${UPSTREAM_DNS:-}" ]; then
        : > /etc/resolv.conf
        for d in $UPSTREAM_DNS; do echo "nameserver $d" >> /etc/resolv.conf; done
    else
        echo "nameserver 8.8.8.8" > /etc/resolv.conf
    fi
fi
echo "init: dns=$(grep nameserver /etc/resolv.conf 2>/dev/null | head -1)"

# Fetch per-build relay config (collector sink URL + bearer token) from the host
# config responder on the isolated NAT switch. The driver serves it as strict
# KEY=VALUE lines at http://<gateway>:<port>/config, once, then closes it. We
# parse ONLY known keys and never source the body, so a response can never
# execute shell in the relay (the trust boundary). Bounded retry: the responder
# is up before this VM boots, so the first attempt usually succeeds; on repeated
# failure the relay falls back to the local sink. The token is a credential, so
# it is never echoed to the console.
CONFIG_URL="http://${NAT_GW:-192.168.240.1}:${RELAY_CONFIG_PORT:-8299}/config"
GOT_CONFIG=0
TRIES=0
while [ $TRIES -lt 30 ]; do
    if wget -q -T 2 -O /tmp/relay-config "$CONFIG_URL" 2>/dev/null; then
        GOT_CONFIG=1; break
    fi
    TRIES=$((TRIES + 1)); sleep 0.5
done
if [ "$GOT_CONFIG" = 1 ] && [ -s /tmp/relay-config ]; then
    while IFS='=' read -r k v; do
        case "$k" in
            OUTPUT_SINK_URL)   export OUTPUT_SINK_URL="$v" ;;
            OUTPUT_SINK_TOKEN) export OUTPUT_SINK_TOKEN="$v" ;;
        esac
    done < /tmp/relay-config
    rm -f /tmp/relay-config
    CFG_MSG="init: relay config fetched (sink=${OUTPUT_SINK_URL:-none}, token=$([ -n "${OUTPUT_SINK_TOKEN:-}" ] && echo set || echo unset))"
else
    CFG_MSG="init: no relay config fetched; relay will use the local sink"
fi
echo "$CFG_MSG" > /dev/ttyS0 2>/dev/null || true
echo "$CFG_MSG"

# Signal readiness to the host over COM1 (host reads the named pipe).
echo "ready" > /dev/ttyS0 2>/dev/null || true
echo "init: ready"

# Launch the baked-in relay. PID 1 must NEVER exit, or the kernel panics
# ("Attempted to kill init"), so init SUPERVISES rather than exec's: it runs the
# relay in the foreground and, if the relay is absent (bare boot-bring-up test
# with no baked binary) or returns for any reason, idles so the host can observe
# the VM and tear it down cleanly rather than seeing a panic-reboot loop.
# Explicit "-mode vm" (no /shared/relay.env auto-detect, since the data disk is
# gone). /ledger and /context live on tmpfs; large outputs never land here.
mkdir -p /ledger /context
if [ -x /sbin/relay ]; then
    # Route the relay's own stdout/stderr to COM1 so the host (and this boot
    # test) can see its startup diagnostics; the relay's ledger/artifacts go
    # out-of-band over HTTP to the collector, not through this console.
    /sbin/relay -mode vm > /dev/ttyS0 2>&1
    RC=$?
    echo "init: relay exited ($RC); idling for host teardown" > /dev/ttyS0 2>/dev/null || true
    echo "init: relay exited ($RC); idling for host teardown"
else
    echo "init: no relay binary present; idling (boot-test mode)" > /dev/ttyS0 2>/dev/null || true
    echo "init: no relay binary present; idling (boot-test mode)"
fi
while true; do sleep 3600; done
