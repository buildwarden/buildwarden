# Medium-complexity demo: Python cryptography library from source.
# Triggers Rust/Cargo downloads under the hood (cryptography uses a Rust backend),
# plus pip, apt, and OpenSSL — showing multi-ecosystem ledger entries.

FROM python:3.12-slim

# Install system dependencies for building cryptography
RUN apt-get update
RUN apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libssl-dev \
        pkg-config


# Install Python build tools
RUN pip install --disable-pip-version-check build

# Download cryptography source at a pinned release
RUN mkdir -p /src/cryptography
WORKDIR /src/cryptography

RUN python -c "from urllib.request import urlopen; import sys; \
        sys.stdout.buffer.write(urlopen(sys.argv[1]).read())" \
        https://github.com/pyca/cryptography/archive/refs/tags/44.0.3.tar.gz \
        | tar xz --strip-components=1 -C /src/cryptography


# Build a wheel for the artifact
RUN python -m build --wheel

# Post the wheel
RUN warden-io post dist/cryptography-*.whl

# Install testing dependencies 
RUN pip install -e ".[test]" 2>&1

# Run a subset of the test suite to generate more ledger entries
RUN python -m pytest tests/hazmat/primitives/test_hashes.py -x -q --tb=short 2>&1
