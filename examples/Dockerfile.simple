FROM python:3.12-slim

# Install build tools
RUN pip install --upgrade pip build

# Download the requests source distribution
RUN pip download --no-binary :all: --no-deps requests==2.32.3 -d /tmp/sdist

# Extract source
RUN tar xzf /tmp/sdist/requests-*.tar.gz -C /tmp

# Build a wheel from source
WORKDIR /tmp/requests-2.32.3
RUN python -m build --wheel

# Post the built wheel as an artifact
RUN WHEEL=$(ls dist/requests-*.whl) && warden-io post "$WHEEL"
