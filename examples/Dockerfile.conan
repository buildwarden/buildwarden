FROM python:3.12-slim

# Install C/C++ build tools needed by Conan
RUN apt-get update
RUN apt-get install -y --no-install-recommends gcc g++ make cmake

# Install Conan package manager
RUN pip install conan

# Initialize default profile
RUN conan profile detect

# Install zlib dependency (builds from source)
RUN conan install --requires=zlib/1.3.1 --build=missing
