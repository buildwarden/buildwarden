# Expanded demo: build requests from source, post artifact, run tests.
# Demonstrates the truncatable property of the ledger — test/lint network fetches
# appear as separate ledger entries from the build itself.

FROM python:3.12-slim

# Install Python build tool
RUN pip install --disable-pip-version-check build

WORKDIR /src/requests

# Download requests source at a pinned release
RUN python -c "from urllib.request import urlopen; import sys; \
        sys.stdout.buffer.write(urlopen(sys.argv[1]).read())" \
        https://github.com/psf/requests/archive/refs/tags/v2.34.2.tar.gz \
        | tar xz --strip-components=1 -C /src/requests

# Build the wheel from source
RUN python -m build --wheel

# Post the built wheel as an artifact
RUN warden-io post dist/requests-*.whl

RUN pip install --upgrade pip

RUN ls -a

# Install test dependencies from the project's dependency groups
RUN pip install --disable-pip-version-check --group test .[socks]

# Run the test suite (network fetches for test fixtures appear in ledger)
RUN python -m pytest tests/ -k 'not timeout' -v --tb=short
